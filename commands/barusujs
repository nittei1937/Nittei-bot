const {
    SlashCommandBuilder
} = require("discord.js");

const fs = require("fs");
const path = require("path");

const BARUSU = JSON.parse(
    fs.readFileSync(
        path.join(__dirname, "..", "data", "barusu.json"),
        "utf8"
    )
);

const command = new SlashCommandBuilder()
    .setName("barusu")
    .setDescription("バルスを放ちます。")
    .addStringOption(option => {

        option
            .setName("type")
            .setDescription("種類")
            .setRequired(true);

        Object.entries(BARUSU).forEach(([id, data]) => {

            option.addChoices({
                name: data.name,
                value: id
            });

        });

        return option;

    })
    .addUserOption(option =>
        option
            .setName("user")
            .setDescription("対象")
            .setRequired(true)
    );

module.exports = {
    data: command,

    async execute(interaction) {

        const type = interaction.options.getString("type");
        const member = interaction.options.getMember("user");

        const data = BARUSU[type];

        if (!data) {
            return interaction.reply({
                content: "種類が見つかりません。",
                ephemeral: true
            });
        }

        await interaction.reply({
            content: `${member.displayName}${data.message}`
        });

    }
};